# Pick ONE free provider: gemini (recommended), groq, openrouter, or ollama
AI_PROVIDER=gemini

# Paste the key for the provider you picked (keys are free, no card needed):
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys

# Optional: override the provider's default model
# AI_MODEL=
PORT=3000

# Reminder calls (real phone calls) - https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # your Twilio number, e.g. +12025550123
REMINDER_MINUTES_BEFORE=120
# PUBLIC_URL=            # only if you don't use cloudflared (e.g. an ngrok URL)

# Clinic owner dashboard login (if empty, a password is generated on first start and saved in .env)
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional: keep one extra slot free today for testing reminder calls, e.g. 18:00
# TEST_SLOT_TIME=
